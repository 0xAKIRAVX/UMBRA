<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Umbra" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/umbra_void</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Android 12+ system splash: brand void background behind the globe icon -->
        <item name="android:windowSplashScreenBackground">@color/umbra_void</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/umbra_void</item>
    </style>
</resources>
